---
import SiteMark from '@/components/ui/SiteMark.astro';
import { profile } from '@/data/profile';

const year = new Date().getFullYear();
const socials = profile.primarySocials.map((k) => profile.socials[k]);
---

<footer class="border-t border-hairline">
  <div class="shell flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
    <div class="flex items-start gap-4">
      <SiteMark size={30} tinted class="mt-0.5 shrink-0" />
      <div>
        <p class="text-[0.9375rem] font-medium">{profile.name}</p>
        <p class="mt-1.5 text-sm text-ink-2">{profile.headline}</p>
        <p class="meta mt-1.5">{profile.positioning}</p>
        <p class="meta mt-1">
          Also known as {profile.creativeName}
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-4 md:items-end">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="meta link-underline transition-colors hover:text-ink"
              >
                {s.label}
              </a>
            </li>
          ))
        }
        {
          profile.cv.available && (
            <li>
              <a href={profile.cv.href} class="meta link-underline transition-colors hover:text-ink">
                CV ↓
              </a>
            </li>
          )
        }
      </ul>
      <p class="meta">© {year} {profile.name}</p>
    </div>
  </div>
</footer>
