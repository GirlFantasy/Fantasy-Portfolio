---
import SiteMark from '@/components/ui/SiteMark.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { profile } from '@/data/profile';

const links = [
  { label: 'Work', href: '/#work' },
  { label: 'Pillars', href: '/#pillars' },
  { label: 'Writing', href: '/#writing' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/#contact' },
];
---

<header
  class="sticky top-0 z-40 border-b border-hairline bg-bg/85 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <nav class="shell flex h-16 items-center justify-between gap-6" aria-label="Primary">
    <a
      href="/"
      class="group flex items-center gap-3 transition-opacity hover:opacity-70"
      aria-label={`${profile.shortName} — home`}
    >
      <SiteMark size={24} tinted />
      <span class="text-[0.9375rem] font-medium tracking-tight">{profile.shortName}</span>
    </a>

    <div class="flex items-center gap-5 md:gap-8">
      <ul class="hidden items-center gap-6 md:flex lg:gap-8">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="meta link-underline transition-colors hover:text-ink">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <ThemeToggle />

      <button
        type="button"
        id="menu-toggle"
        class="-m-2 p-2 text-meta transition-colors hover:text-ink md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.25"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-hairline bg-bg md:hidden">
    <ul class="shell py-2">
      {
        links.map((l) => (
          <li class="border-b border-hairline last:border-0">
            <a href={l.href} class="meta block py-4 transition-colors hover:text-ink" data-menu-link>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  btn?.addEventListener('click', () => {
    setOpen(menu?.classList.contains('hidden') ?? false);
  });

  // Close on navigation and on Escape.
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn?.focus();
    }
  });
</script>
