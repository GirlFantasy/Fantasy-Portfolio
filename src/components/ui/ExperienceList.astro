---
/**
 * Post-graduation roles, shown on the About page.
 * Renders nothing while the collection is empty — so this section simply
 * appears the day the first role is added, with no code change.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'experience'>[];
  class?: string;
}

const { entries, class: className = '' } = Astro.props;

const sorted = [...entries].sort((a, b) => a.data.order - b.data.order);
---

{
  sorted.length > 0 && (
    <section class={className}>
      <h2 class="meta">Experience</h2>
      <ul class="mt-6 border-t border-hairline">
        {sorted.map((role) => (
          <li class="border-b border-hairline py-5">
            <h3 class="font-sans text-[1.0625rem] font-semibold tracking-normal">
              {role.data.role}
            </h3>
            <p class="meta mt-1.5">
              {role.data.organisation} · {role.data.period}
            </p>
            <p class="measure mt-3 text-sm leading-[1.7] text-ink-2">{role.data.summary}</p>
            {role.data.links.length > 0 && (
              <p class="mt-3">
                {role.data.links.map((l) => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="meta mr-4 inline-flex items-center gap-1.5 hover:text-ink"
                  >
                    <span class="link-underline">{l.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
