---
/**
 * Compact recognition ledger for the About page.
 * Shows every entry — frontmatter only, no bodies — grouped by category.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'recognition'>[];
  class?: string;
}

const { entries, class: className = '' } = Astro.props;

/** Display order and headings for the category groups. */
const groups = [
  { key: 'fellowship', label: 'Fellowships' },
  { key: 'leadership', label: 'Leadership' },
  { key: 'competition', label: 'Analytics competitions' },
  { key: 'award', label: 'Awards' },
  { key: 'advocacy', label: 'Advocacy' },
] as const;

const grouped = groups
  .map((g) => ({
    ...g,
    items: entries
      .filter((e) => e.data.category === g.key)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((g) => g.items.length > 0);
---

{
  grouped.length > 0 && (
    <section class={className}>
      <h2 class="meta">Recognition</h2>

      {grouped.map((group) => (
        <div class="mt-8 first:mt-6">
          <p class="meta-note">{group.label}</p>
          <ul class="mt-3 border-t border-hairline">
            {group.items.map((e) => (
              <li class="border-b border-hairline py-4">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  {e.data.placement && (
                    <span class="font-mono text-sm font-medium text-ink">{e.data.placement}</span>
                  )}
                  <p class="text-[0.9375rem] font-medium leading-snug">{e.data.title}</p>
                </div>
                <p class="meta mt-1.5">
                  {e.data.organisation}
                  {e.data.period && ` · ${e.data.period}`}
                </p>
                {e.data.links.length > 0 && (
                  <p class="mt-2">
                    {e.data.links.map((l) => (
                      <a
                        href={l.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="meta mr-4 inline-flex items-center gap-1.5 hover:text-ink"
                      >
                        <span class="link-underline">{l.label}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )
}
