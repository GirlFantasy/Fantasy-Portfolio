---
interface Props {
  numeral: string;
  title: string;
  /** Right-hand mono note, e.g. a source or count. */
  note?: string;
  href?: string;
  hrefLabel?: string;
  id?: string;
  /**
   * Which hue tints the numeral and the rule. Rotating this across sections
   * is what gives the page its colour rhythm.
   */
  accent?: 'data' | 'medicine' | 'blockchain' | 'warm';
}
const {
  numeral,
  title,
  note,
  href,
  hrefLabel,
  id,
  accent = 'data',
} = Astro.props;
---

<header class={`accent-${accent} border-t border-hairline pt-5`} id={id} data-reveal>
  <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
    <div class="flex items-baseline gap-4 md:gap-6">
      <span class="meta shrink-0 pt-1" style="color:var(--accent)">{numeral}</span>
      <h2 class="text-[length:var(--text-display-m)] leading-[1.1]">{title}</h2>
    </div>
    {note && <span class="meta">{note}</span>}
    {
      href && (
        <a
          href={href}
          class="meta link-underline transition-colors"
          style="color:var(--accent)"
        >
          {hrefLabel ?? 'View all'} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
  <div class="mt-4 h-[2px] w-10" style="background:var(--accent)" aria-hidden="true"></div>
</header>
