---
/**
 * Identity mark: three overlapping hairline circles.
 * A Venn of Medicine × Data × Blockchain. Legible down to 16px.
 */
interface Props {
  size?: number;
  class?: string;
  tinted?: boolean;
}
const { size = 26, class: className = '', tinted = false } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <circle
    cx="20" cy="14" r="9"
    stroke={tinted ? 'var(--c-medicine)' : 'currentColor'}
    stroke-width="1.25" opacity={tinted ? '0.9' : '0.85'}
  />
  <circle
    cx="13.5" cy="25" r="9"
    stroke={tinted ? 'var(--c-data)' : 'currentColor'}
    stroke-width="1.25" opacity={tinted ? '0.9' : '0.85'}
  />
  <circle
    cx="26.5" cy="25" r="9"
    stroke={tinted ? 'var(--c-blockchain)' : 'currentColor'}
    stroke-width="1.25" opacity={tinted ? '0.9' : '0.85'}
  />
</svg>
