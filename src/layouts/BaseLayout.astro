---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';

import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { profile, seo } from '@/data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Set on interior pages so the canonical/OG URL is correct. */
  path?: string;
}

const {
  title = seo.title,
  description = seo.description,
  path = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(path, Astro.site ?? Astro.url).toString();

/** Search engines cut descriptions around 160 chars — trim on a word boundary. */
const clamp = (text: string, max = 158) => {
  const t = text.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  return t.slice(0, t.lastIndexOf(' ', max - 1)).replace(/[,;:—-]$/, '') + '…';
};
const metaDescription = clamp(description);
const pageTitle = title === seo.title ? title : `${title} — ${profile.shortName}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.creativeName,
  /** The headline is the job title; titleFull is the fuller account beneath it. */
  jobTitle: profile.headline,
  description: `${profile.titleFull}. Working in ${profile.field}.`,
  email: [profile.email, profile.emailSecondary].filter(Boolean).map((e) => `mailto:${e}`),
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressRegion: profile.location },
  alumniOf: profile.education.map((e) => ({
    '@type': 'CollegeOrUniversity',
    name: e.institution,
  })),
  knowsAbout: seo.keywords,
  sameAs: Object.values(profile.socials).map((s) => s.href),
};
---

<!doctype html>
<html lang="en" class="plot-grid">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={profile.name} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.shortName} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site ?? Astro.url).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.headline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c0e" media="(prefers-color-scheme: dark)" />

    <!-- Set theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var p = localStorage.getItem('theme-preference');
          if (p === 'light' || p === 'dark') {
            document.documentElement.setAttribute('data-theme', p);
          }
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
    >
      Skip to content
    </a>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Entrance reveals. One observer, no library.
      const items = document.querySelectorAll('[data-reveal]');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
