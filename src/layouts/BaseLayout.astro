---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';

import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { profile, seo, verification } from '@/data/profile';

interface Props {
  title?: string;
  description?: string;
  /** Set on interior pages so the canonical/OG URL is correct. */
  path?: string;
  /** Keep a page out of search results — the 404 page, and nothing else so far. */
  noindex?: boolean;
}

const {
  title = seo.title,
  description = seo.description,
  path = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, Astro.site ?? Astro.url).toString();

/** Search engines cut descriptions around 160 chars — trim on a word boundary. */
const clamp = (text: string, max = 158) => {
  const t = text.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  return t.slice(0, t.lastIndexOf(' ', max - 1)).replace(/[,;:—-]$/, '') + '…';
};
const metaDescription = clamp(description);
const pageTitle = title === seo.title ? title : `${title} — ${profile.shortName}`;

const origin = (Astro.site ?? Astro.url).origin + '/';
const abs = (p: string) => new URL(p, Astro.site ?? Astro.url).toString();

const person = {
  '@type': 'Person',
  '@id': `${origin}#person`,
  name: profile.name,
  alternateName: profile.creativeName,
  /** The headline is the job title; titleFull is the fuller account beneath it. */
  jobTitle: profile.headline,
  description: `${profile.titleFull}. Working in ${profile.field}.`,
  email: [profile.email, profile.emailSecondary].filter(Boolean).map((e) => `mailto:${e}`),
  url: origin,
  /** Google looks for an image on a Person when it builds a knowledge panel. */
  image: abs(profile.portrait.src),
  address: { '@type': 'PostalAddress', addressRegion: profile.location },
  /**
   * One entry per institution, typed by what it actually is. Deduplicated by
   * name: two qualifications taken at the same university are one alma mater,
   * not two.
   */
  alumniOf: [...new Map(profile.education.map((e) => [e.institution, e])).values()].map((e) => ({
    '@type': e.schemaType,
    name: e.institution,
  })),
  knowsAbout: seo.keywords,
  /** Every verified profile, so search engines can tie them to this site. */
  sameAs: Object.values(profile.socials).map((s) => s.href),
};

/** Names the site itself — what lets a search for your name resolve to it. */
const website = {
  '@type': 'WebSite',
  '@id': `${origin}#website`,
  url: origin,
  name: profile.name,
  alternateName: [profile.shortName, profile.creativeName],
  inLanguage: 'en',
  publisher: { '@id': `${origin}#person` },
};

/**
 * Breadcrumbs for interior pages — Google shows these in place of a raw URL.
 * Derived from the path, so any new page gets them without extra work.
 */
const segments = path.split('/').filter(Boolean);

/**
 * Intermediate segments need a real destination — `/pillars/` is a route prefix
 * with no page behind it, so that crumb points at the homepage section that
 * lists them instead. A breadcrumb linking to a 404 is worse than no breadcrumb.
 */
const crumbs: Record<string, { name: string; href: string }> = {
  pillars: { name: 'Pillars', href: '/#pillars' },
  work: { name: 'Work', href: '/work/' },
  about: { name: 'About', href: '/about/' },
};

const breadcrumb =
  segments.length > 0 && !noindex
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: origin },
          ...segments.map((seg, i) => {
            const isLast = i === segments.length - 1;
            const known = crumbs[seg];
            return {
              '@type': 'ListItem',
              position: i + 2,
              name: isLast && !known ? title : (known?.name ?? seg),
              item:
                isLast || !known
                  ? abs('/' + segments.slice(0, i + 1).join('/') + '/')
                  : abs(known.href),
            };
          }),
        ],
      }
    : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, ...(breadcrumb ? [breadcrumb] : [])],
};
---

<!doctype html>
<html lang="en" class="plot-grid">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {/* SVG for modern browsers, PNG for the crawlers and platforms that ignore it. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={profile.name} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.shortName} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site ?? Astro.url).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.headline}`} />
    <meta property="og:locale" content="en_NG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.jpg', Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {/* Credits you when someone shares a page, and links the card to your account. */}
    <meta name="twitter:creator" content={profile.socials.x.handle} />

    {verification.google && (
      <meta name="google-site-verification" content={verification.google} />
    )}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}

    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c0e" media="(prefers-color-scheme: dark)" />

    <!-- Set theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var p = localStorage.getItem('theme-preference');
          if (p === 'light' || p === 'dark') {
            document.documentElement.setAttribute('data-theme', p);
          }
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-ink focus:px-4 focus:py-2 focus:text-bg"
    >
      Skip to content
    </a>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Entrance reveals. One observer, no library.
      const items = document.querySelectorAll('[data-reveal]');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
