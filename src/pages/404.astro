---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="shell flex min-h-[55vh] flex-col justify-center py-20">
    <p class="meta">Error 404</p>
    <h1 class="mt-5 text-[length:var(--text-display-l)] leading-[1.05]">Nothing here</h1>
    <p class="measure mt-5 text-lg text-ink-2">
      That page does not exist — or has moved.
    </p>
    <p class="mt-8">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-medium">
        <span aria-hidden="true">←</span>
        <span class="link-underline">Back to the homepage</span>
      </a>
    </p>
  </section>
</BaseLayout>
