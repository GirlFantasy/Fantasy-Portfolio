---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Intersection from '@/components/viz/Intersection.astro';
import { profile } from '@/data/profile';
import { copy } from '@/data/copy';

const pillars = (await getCollection('pillars'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="About"
  description={`${profile.name} — ${profile.titleFull}. ${profile.statement.join(" ")}`}
>
  <div class="shell pt-14 md:pt-20">
    <header class="border-b border-hairline pb-10">
      <p class="meta">About</p>
      <h1 class="mt-5 max-w-[18ch] text-[length:var(--text-display-l)] leading-[1.05]">
        {profile.name}
      </h1>
      <p class="measure mt-6 text-lg leading-[1.65] text-ink-2">{profile.titleFull}.</p>
    </header>

    <div class="mt-14 grid grid-cols-1 gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="prose">
          <p>
            I am a {profile.title.toLowerCase()} at {profile.education[0].institution} ({
              profile.education[0].abbr
            }), a blockchain data analyst, and a data storyteller. Based in {profile.location}.
          </p>

          {copy.about.opening.map((para) => <p>{para}</p>)}

          <h2>{copy.about.connectsHeading}</h2>

          {copy.about.connectsParagraphs.map((para) => <p>{para}</p>)}

          <h2>{copy.about.whereHeading}</h2>

          <p>{copy.about.whereIntro}</p>

          <ul>
            {
              pillars.map((p) => (
                <li>
                  <a href={`/pillars/${p.id}`}>
                    <strong>{p.data.title}</strong>
                  </a>{' '}
                  — {p.data.intro}
                </li>
              ))
            }
          </ul>

          <h2>{copy.about.educationHeading}</h2>

          {
            profile.education.map((e) => (
              <p>
                <strong>{e.institution}</strong> ({e.abbr}) — {e.programme}.
                {e.current && ` Expected ${e.expected}.`}
              </p>
            ))
          }

          <h2>{copy.about.nameHeading}</h2>

          <p>{copy.about.nameParagraph}</p>

        </div>

        <div class="mt-14 flex flex-wrap gap-4 border-t border-hairline pt-8">
          <a
            href={`mailto:${profile.email}`}
            class="inline-flex items-center gap-2.5 border border-data bg-data px-6 py-3 text-sm font-medium text-bg transition-colors duration-300 hover:bg-transparent hover:text-data"
          >
            Get in touch
          </a>
          {
            profile.cv.available && (
              <a
                href={profile.cv.href}
                class="inline-flex items-center gap-2.5 border border-hairline-strong px-6 py-3 text-sm font-medium transition-colors duration-300 hover:border-ink"
              >
                Download CV <span aria-hidden="true">↓</span>
              </a>
            )
          }
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          <div class="aspect-[4/5] w-full overflow-hidden border border-hairline bg-surface-2">
            {
              profile.portrait.isReal ? (
                <img
                  src={profile.portrait.src}
                  alt={profile.portrait.alt}
                  width="1024"
                  height="1536"
                  loading="eager"
                  class="h-full w-full object-cover"
                  style={`object-position:${profile.portrait.objectPosition}`}
                />
              ) : (
                <div class="plot-grid flex h-full w-full items-center justify-center">
                  <span class="font-display text-5xl text-meta">CE</span>
                </div>
              )
            }
          </div>
          <p class="meta mt-4">Fig. — {profile.shortName}, {profile.location}</p>

          <Intersection class="mt-12 w-full max-w-[280px] text-ink" />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
