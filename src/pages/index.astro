---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import DomainTag from '@/components/ui/DomainTag.astro';
import { profile } from '@/data/profile';
import { accentClass } from '@/lib/domain';
import { copy } from '@/data/copy';

const pillars = (await getCollection('pillars'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

/** One line per pillar describing what a visitor will find on that page. */
const contents: Record<string, string[]> = {
  'medicine-global-health': [
    'Whose needs get overlooked, and why',
    "Women's health & gender equality",
    'Her Path to Power — SRHR & agency',
    'Millennium Fellow & Campus Director',
  ],
  'blockchain-healthcare': [
    'The records problem, and what blockchain could address',
    'What it will and will not solve',
    'Blockchain EHRs in Africa — scoping review, ongoing',
    'Explorations on Substack',
  ],
  'blockchain-data': [
    'DataInByte — my adoption intelligence project',
    'On-chain dashboards on Dune',
    'Awards & analytics competitions',
    'Writing, speaking & toolkit',
  ],
};

const contactLinks = (
  ['x', 'linkedin', 'github', 'substack', 'dune', 'tiktok'] as const
).map((k) => profile.socials[k]);
---

<BaseLayout>
  <Hero />

  {/* ── 01 · About ─────────────────────────────────────────────────────── */}
  <section class="shell scroll-mt-24" id="about">
    <SectionHeader numeral="01" title="The intersection" href="/about" hrefLabel="Read more" accent="data" />

    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4" data-reveal>
        <div class="relative aspect-[4/5] w-full overflow-hidden border border-hairline bg-surface-2">
          {
            profile.portrait.isReal ? (
              <img
                src={profile.portrait.src}
                alt={profile.portrait.alt}
                width="1024"
                height="1536"
                loading="eager"
                class="h-full w-full object-cover"
                style={`object-position:${profile.portrait.objectPosition}`}
              />
            ) : (
              <div class="plot-grid flex h-full w-full items-center justify-center">
                <span class="font-display text-5xl text-meta">CE</span>
              </div>
            )
          }
        </div>
        <p class="meta mt-4">Fig. — {profile.shortName}</p>
      </div>

      <div class="lg:col-span-8" data-reveal style="--reveal-delay:80ms">
        <p class="font-display text-[1.6rem] leading-[1.2] tracking-[-0.02em] text-ink sm:text-[1.85rem]">
          {copy.homeAbout.lead}
        </p>
        <p class="mt-2.5 text-[0.8125rem] font-semibold italic leading-[1.5] text-ink-2">
          {copy.homeAbout.credentials}
        </p>
        {
          copy.homeAbout.paragraphs.map((para) => (
            <p class="mt-5 leading-[1.75] text-ink-2">{para}</p>
          ))
        }

        {
          copy.homeAbout.pullQuote.length > 0 && (
            <blockquote class="accent-data my-9">
              <div class="accent-rule mb-6" aria-hidden="true" />
              {/* Same size and rhythm as the surrounding paragraphs; the serif
                  face and darker ink are what keep it a distinct block. */}
              {copy.homeAbout.pullQuote.map((line) => (
                <p class="font-display text-[1.0625rem] leading-[1.75] text-ink">
                  {line}
                </p>
              ))}
            </blockquote>
          )
        }

        {
          copy.homeAbout.paragraphsAfter.map((para) => (
            <p class="mt-5 leading-[1.75] text-ink-2">{para}</p>
          ))
        }
        <a href="/about" class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-ink">
          <span class="link-underline">Read the full story</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

    </div>
  </section>

  {/* ── 02 · The three pillars — the directory ─────────────────────────── */}
  <section class="shell mt-[var(--spacing-section)] scroll-mt-24" id="pillars">
    <SectionHeader
      numeral="02"
      title="Three parts of the work"
      note="Choose a path"
      accent="medicine"
    />

    <div class="mt-10 flex flex-col gap-6">
      {
        pillars.map((pillar, i) => (
          <article data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <a
              href={`/pillars/${pillar.id}`}
              class={`card-accent group block p-7 md:p-10 ${accentClass(pillar.data.domains)}`}
            >
              <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10">
                <div class="md:col-span-7">
                  <div class="flex flex-wrap items-center justify-between gap-4">
                    <span class="chip">{pillar.data.numeral} · {pillar.data.kicker}</span>
                    <DomainTag domains={pillar.data.domains} class="md:hidden" />
                  </div>

                  <h3 class="mt-6 text-[length:var(--text-display-m)] leading-[1.12]">
                    {pillar.data.title}
                  </h3>

                  {/* Directory view: first two paragraphs only. The rest is on the page. */}
                  {pillar.data.intro.slice(0, 2).map((para) => (
                    <p class="measure mt-4 leading-[1.7] text-ink-2">{para}</p>
                  ))}

                  <span
                    class="mt-7 inline-flex items-center gap-2 text-sm font-semibold transition-all duration-500 group-hover:gap-3"
                    style="color:var(--accent)"
                  >
                    <span class="link-underline">Explore this work</span>
                    <span aria-hidden="true">→</span>
                  </span>
                </div>

                <div class="md:col-span-5">
                  <p class="meta">What's inside</p>
                  <ul class="mt-4 space-y-2.5">
                    {
                      (contents[pillar.id] ?? []).map((line) => (
                        <li class="flex items-baseline gap-3 text-sm leading-snug text-ink-2">
                          <span
                            class="mt-[6px] inline-block h-[5px] w-[5px] shrink-0 rounded-full"
                            style="background:var(--accent)"
                            aria-hidden="true"
                          />
                          {line}
                        </li>
                      ))
                    }
                  </ul>
                  <div class="mt-6 hidden md:block">
                    <DomainTag domains={pillar.data.domains} />
                  </div>
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  {/* ── 03 · Education & certifications ────────────────────────────────── */}
  <section class="shell mt-[var(--spacing-section)] scroll-mt-24" id="credentials">
    <SectionHeader
      numeral="03"
      title="Education & certifications"
      note={`${profile.certifications.length} certifications`}
      accent="blockchain"
    />

    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5" data-reveal>
        <p class="meta">Education</p>
        {
          profile.education.map((e) => (
            <div class="mt-5 border-t border-hairline pt-5">
              <h3 class="font-sans text-[1.0625rem] font-semibold tracking-normal">
                {e.programme}
              </h3>
              <p class="mt-1.5 text-sm text-ink-2">
                {e.school}, {e.institution}
              </p>
              <p class="meta mt-2">{e.period}</p>
            </div>
          ))
        }

        <p class="meta mt-10">Student leadership</p>
        <ul class="mt-4 border-t border-hairline">
          {
            profile.medicalRoles.map((role) => (
              <li class="border-b border-hairline py-3 text-sm text-ink-2">{role}</li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-7" data-reveal style="--reveal-delay:80ms">
        <p class="meta">Certifications</p>
        <ul class="mt-5 border-t border-hairline">
          {
            profile.certifications.map((c) => (
              <li class="grid grid-cols-1 gap-1 border-b border-hairline py-4 md:grid-cols-12 md:gap-6">
                <div class="md:col-span-8">
                  <p class="text-[0.9375rem] font-medium leading-snug">{c.title}</p>
                  <p class="meta mt-1.5">{c.issuer}</p>
                </div>
                <p class="meta md:col-span-4 md:text-right">{c.period}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ── 04 · Contact — the one large colour moment ─────────────────────── */}
  <section class="panel accent-data mt-[var(--spacing-section)] scroll-mt-24" id="contact">
    <div class="shell py-[var(--spacing-section)]">
      <header data-reveal>
        <div class="flex flex-wrap items-baseline gap-4 md:gap-6">
          <span class="meta shrink-0">04</span>
          <h2 class="text-[length:var(--text-display-l)] leading-[1.05]">Let's connect</h2>
        </div>
        <div class="mt-5 h-[2px] w-12" style="background:var(--c-data)" aria-hidden="true"></div>
      </header>

      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-7" data-reveal>
          {/* Restate who they are writing to — this is often the only section read. */}
          <p class="font-display text-[1.35rem] leading-[1.25] tracking-[-0.015em] sm:text-[1.5rem]">
            {profile.headline}
          </p>
          <p class="meta mt-2.5">{profile.field} · {profile.location}</p>

          <p class="measure mt-7 text-lg leading-[1.65]" style="color:var(--c-panel-muted)">
            {copy.contact.intro}
          </p>

          <a
            href={`mailto:${profile.email}`}
            class="mt-8 inline-block font-mono text-[1.25rem] leading-tight tracking-tight break-words sm:text-[length:var(--text-display-m)]"
          >
            <span class="link-underline">{profile.email}</span>
          </a>

          {
            profile.emailSecondary && (
              <a
                href={`mailto:${profile.emailSecondary}`}
                class="mt-4 block font-mono text-[0.9375rem] leading-tight tracking-tight break-words sm:text-lg"
                style="color:var(--c-panel-muted)"
              >
                <span class="link-underline">{profile.emailSecondary}</span>
              </a>
            )
          }
        </div>

        <div class="lg:col-span-5" data-reveal style="--reveal-delay:80ms">
          <p class="meta mb-5">Elsewhere</p>
          <ul style="border-top:1px solid var(--c-panel-line)">
            {
              contactLinks.map((s) => (
                <li style="border-bottom:1px solid var(--c-panel-line)">
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-baseline justify-between gap-6 py-4 transition-opacity hover:opacity-75"
                  >
                    <span class="text-[0.9375rem] font-medium">{s.label}</span>
                    <span class="meta flex items-center gap-2 transition-all duration-300 group-hover:gap-3">
                      {s.handle} <span aria-hidden="true">↗</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
