---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import DomainTag from '@/components/ui/DomainTag.astro';

const work = (await getCollection('work'))
  .filter((w) => !w.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const research = work.filter((w) => w.data.type === 'research');
const analysis = work.filter((w) => w.data.type !== 'research');

const groups = [
  { title: 'Analysis', items: analysis },
  { title: 'Research', items: research },
].filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Work"
  description="Selected analysis and research by Chimdalu Nnenne Egwu across blockchain data, healthcare technology and medical research."
>
  <div class="shell pt-14 md:pt-20">
    <header class="border-b border-hairline pb-10">
      <p class="meta">Index</p>
      <h1 class="mt-5 text-[length:var(--text-display-l)] leading-[1.05]">Work</h1>
      <p class="measure mt-6 text-lg leading-[1.65] text-ink-2">
        Analysis and research across on-chain data, healthcare technology and
        medicine. Each entry opens as a full case study.
      </p>
    </header>

    {
      groups.map((group) => (
        <section class="mt-16">
          <h2 class="meta">{group.title}</h2>
          <ul class="mt-6 border-t border-hairline">
            {group.items.map((item, i) => (
              <li class="border-b border-hairline" data-reveal style={`--reveal-delay:${i * 60}ms`}>
                <a
                  href={item.data.caseStudy ? `/work/${item.id}` : '#'}
                  class="group grid grid-cols-1 gap-4 py-8 md:grid-cols-12 md:gap-8"
                >
                  <div class="md:col-span-7">
                    <h3 class="max-w-[42ch] text-xl leading-[1.25]">
                      <span class="link-underline">{item.data.title}</span>
                    </h3>
                    <p class="measure mt-3 text-sm leading-[1.7] text-ink-2">
                      {item.data.summary}
                    </p>
                  </div>
                  <div class="md:col-span-3">
                    <DomainTag domains={item.data.domains} />
                    {item.data.method && <p class="meta mt-2">{item.data.method}</p>}
                  </div>
                  <div class="md:col-span-2 md:text-right">
                    <span class="meta inline-flex items-center gap-2 transition-all duration-300 group-hover:gap-3 group-hover:text-ink">
                      Read <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
